# Copy this file to .env and fill in your keys. .env is git-ignored.

# ---------- LLM providers (at least ONE required) ----------
# Google Gemini (free tier): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# Optional: any OpenAI-compatible endpoint (OpenAI, OpenRouter, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Per-agent model choice: "<provider>:<model>". Leave blank for defaults.
# Providers: gemini | groq | openai
LLM_COORDINATOR=
LLM_PLANNER=
LLM_DISCOVERY=
LLM_LOGISTICS=
LLM_PROFILE=
# Comma-separated fallback chain used when the primary model fails / is rate limited
LLM_FALLBACKS=
# Client-side requests-per-minute per model (free tiers: Gemini flash ~10, flash-lite ~15, Groq ~30).
# Raise them if you have a paid key; 0 disables the limiter.
GEMINI_RPM=
GROQ_RPM=

# ---------- Real-world data APIs ----------
# Geoapify (free 3000 req/day): places, geocoding, routing — https://myprojects.geoapify.com
GEOAPIFY_API_KEY=
# Tavily (free 1000/month): web search for live events — https://app.tavily.com
TAVILY_API_KEY=
# SerpApi (optional, free 250/month): Google Flights / Hotels / Events — https://serpapi.com
SERPAPI_API_KEY=

# No key needed: Open-Meteo (weather), OpenStreetMap Nominatim/Overpass (geo/places fallback),
# OSRM (routing fallback), Frankfurter (FX rates), Nager.Date (holidays), Wikipedia (destination brief)

# ---------- App ----------
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
MAX_COORDINATOR_STEPS=14
MAX_REVISIONS=3
# Contact string sent in the User-Agent to OpenStreetMap services (their usage policy requires it)
OSM_CONTACT=lifeplan-ai-student-project
